{
  "expo": {
    "name": "Campaign",
    "slug": "campaign-amplification",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.campaign.amplify"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171716",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.campaign.amplify"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Campaign uses your photos so you can add pictures to your campaign."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Campaign uses the microphone so you can speak your answers instead of typing.",
          "speechRecognitionPermission": "Campaign turns your speech into text for your answers."
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECEAE4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#121211",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "scheme": "campaign",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1a73bd92-7a60-4733-936f-dd7d657bf6fb"
      }
    },
    "owner": "santhosh0619"
  }
}