{
  "expo": {
    "name": "Campaign",
    "slug": "campaign-amplification",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.santhosh0619.campaignamplification"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171716",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.santhosh0619.campaignamplification",
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Campaign uses your photos so you can add pictures to your campaign."
        }
      ]
    ],
    "scheme": "campaign",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECEAE4"
    },
    "extra": {}
  }
}
